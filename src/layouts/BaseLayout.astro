---
import { SEO } from 'astro-seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
  };
  breadcrumbs?: { name: string; item: string }[];
  noindex?: boolean;
}

const { title, description, image, article, breadcrumbs, noindex } = Astro.props;
const isErrorPage = noindex || Astro.url.pathname === '/404' || Astro.url.pathname === '/404.html';
// 404 / error pages canonical-ize to homepage so they don't pollute index with a
// "/404/" URL that itself returns 404.
const canonicalURL = isErrorPage
  ? Astro.site!.toString()
  : new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image
  ? new URL(image, Astro.site).toString()
  : new URL('/og-default.jpg', Astro.site).toString();

// Auto-derive breadcrumbs if not provided (skip homepage + error pages)
const autoCrumbs = (() => {
  if (breadcrumbs) return breadcrumbs;
  const path = Astro.url.pathname.replace(/\/$/, '');
  if (!path) return null;
  if (path === '/404' || path === '/404.html' || path.endsWith('/404.html')) return null;
  const parts = path.split('/').filter(Boolean);
  const crumbs = [{ name: 'Home', item: new URL('/', Astro.site).toString() }];
  let acc = '';
  for (let i = 0; i < parts.length; i++) {
    acc += '/' + parts[i];
    const isLast = i === parts.length - 1;
    const name = isLast
      ? title.split('—')[0].trim()
      : parts[i].charAt(0).toUpperCase() + parts[i].slice(1);
    crumbs.push({ name, item: new URL(acc + '/', Astro.site).toString() });
  }
  return crumbs;
})();

// GEO/AIO: every page has a markdown twin at <path-minus-trailing-slash>.md
// (homepage -> /index.md). Advertised via rel=alternate so AI crawlers and
// answer engines can fetch clean markdown instead of parsing HTML.
const mdAlternate = (() => {
  if (isErrorPage) return null;
  const path = Astro.url.pathname.replace(/\/$/, '');
  if (!path) return '/index.md';
  if (path === '/blog') return null; // blog index has no .md twin; /llms.txt covers it
  return `${path}.md`;
})();

const breadcrumbLd = autoCrumbs && autoCrumbs.length > 1
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: autoCrumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: c.item,
      })),
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a0f2e" />
    <meta name="application-name" content="Mallo Digital" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Mallo Digital — Blog" href="/rss.xml" />
    {mdAlternate && <link rel="alternate" type="text/markdown" title="Markdown version" href={mdAlternate} />}
    <!-- Preconnect to render-critical third-party origins to drop the
         TCP+TLS handshake off the first request to each (mobile LCP win). -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://storage.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://images.leadconnectorhq.com" crossorigin />
    <link rel="dns-prefetch" href="https://services.leadconnectorhq.com" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" /></noscript>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Google Preferred Sources button library
         (https://developers.google.com/search/docs/appearance/preferred-sources).
         Renders every [google-add-preferred-source-btn] element on the page. -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <!-- Site-wide overrides (BorderGlow + StaggeredMenu + GHL polish) -->
    <script src="/assets/site-overrides.js" defer></script>
    <link rel="stylesheet" href="/assets/mallo-theme.css" />
    <script src="/assets/mallo-effects.js" defer></script>
    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SG9EKTBZE0"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-SG9EKTBZE0',{anonymize_ip:true});</script>
    {isErrorPage && <meta name="robots" content="noindex, follow" />}
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          title,
          type: article ? 'article' : 'website',
          image: ogImage,
          url: canonicalURL,
        },
        optional: { description },
        article: article
          ? {
              publishedTime: article.publishedTime,
              modifiedTime: article.modifiedTime,
              tags: article.tags,
            }
          : undefined,
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImage,
      }}
    />
    {breadcrumbLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    )}
    {/* P2-12 from the May 2026 audit: sitewide Organization + WebSite entity
        graph so every page (not just the homepage) gives Google the brand
        anchor. Linked via @id so other JSON-LD on the page can reference it. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://shortnsweetdigital.com/#organization',
          name: 'Mallo Digital',
          url: 'https://shortnsweetdigital.com/',
          logo: 'https://storage.googleapis.com/msgsndr/LHvDkOgXpZdUYdjFzBff/media/66d68a8784ef295b74e11ebf.png',
          description: 'White-label GoHighLevel agency helping small businesses and agencies replace 8–12 marketing tools with one AI-powered platform.',
          sameAs: [
            'https://www.facebook.com/shortnsweetmarketing',
            'https://www.instagram.com/shortnsweetdigital',
            'https://www.linkedin.com/company/shortnsweet-marketing/',
          ],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://shortnsweetdigital.com/#website',
          url: 'https://shortnsweetdigital.com/',
          name: 'Mallo Digital',
          publisher: { '@id': 'https://shortnsweetdigital.com/#organization' },
        },
        {
          // LocalBusiness — service-area type since we serve clients
          // remotely across the US from Palm City, FL. 24/7 because the
          // platform is AI-run.
          '@type': ['LocalBusiness', 'ProfessionalService'],
          '@id': 'https://shortnsweetdigital.com/#localbusiness',
          name: 'Mallo Digital',
          image: 'https://storage.googleapis.com/msgsndr/LHvDkOgXpZdUYdjFzBff/media/66d68a8784ef295b74e11ebf.png',
          url: 'https://shortnsweetdigital.com/',
          telephone: '+1-877-455-7727',
          priceRange: '$$',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Palm City',
            addressRegion: 'FL',
            addressCountry: 'US',
          },
          areaServed: { '@type': 'Country', name: 'United States' },
          openingHoursSpecification: [{
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
            opens: '00:00',
            closes: '23:59',
          }],
          parentOrganization: { '@id': 'https://shortnsweetdigital.com/#organization' },
        },
      ],
    })} />
  </head>
  <body>
    <div class="mallo-sprinkles" aria-hidden="true"><i style="--x:43%;--y:21%;--c:#ff5c99;--r:101deg;--d:9.9s;--dl:-0.7s"></i><i style="--x:70%;--y:14%;--c:#ffd23f;--r:93deg;--d:9.5s;--dl:-9.1s"></i><i style="--x:29%;--y:6%;--c:#5ef2c0;--r:22deg;--d:8.6s;--dl:-0.7s"></i><i style="--x:13%;--y:72%;--c:#3b9bff;--r:108deg;--d:6.4s;--dl:-5.7s"></i><i style="--x:30%;--y:82%;--c:#a67cff;--r:160deg;--d:9.5s;--dl:-0.6s"></i><i style="--x:76%;--y:52%;--c:#ff5c99;--r:12deg;--d:11.9s;--dl:-0.5s"></i><i style="--x:19%;--y:39%;--c:#ffd23f;--r:107deg;--d:6.9s;--dl:-1.2s"></i><i style="--x:41%;--y:73%;--c:#5ef2c0;--r:174deg;--d:7.1s;--dl:-5.8s"></i><i style="--x:83%;--y:26%;--c:#3b9bff;--r:95deg;--d:6.6s;--dl:-7.1s"></i><i style="--x:74%;--y:9%;--c:#a67cff;--r:158deg;--d:7.2s;--dl:-6.8s"></i><i style="--x:56%;--y:42%;--c:#ff5c99;--r:119deg;--d:9.5s;--dl:-4.5s"></i><i style="--x:40%;--y:33%;--c:#ffd23f;--r:46deg;--d:10.2s;--dl:-2.4s"></i><i style="--x:75%;--y:40%;--c:#5ef2c0;--r:134deg;--d:9.0s;--dl:-3.4s"></i><i style="--x:59%;--y:38%;--c:#3b9bff;--r:155deg;--d:11.9s;--dl:-1.2s"></i><i style="--x:55%;--y:23%;--c:#a67cff;--r:87deg;--d:6.9s;--dl:-4.9s"></i><i style="--x:7%;--y:87%;--c:#ff5c99;--r:19deg;--d:10.6s;--dl:-5.7s"></i><i style="--x:42%;--y:45%;--c:#ffd23f;--r:177deg;--d:8.1s;--dl:-5.0s"></i><i style="--x:60%;--y:10%;--c:#5ef2c0;--r:23deg;--d:11.7s;--dl:-4.7s"></i><i style="--x:87%;--y:10%;--c:#3b9bff;--r:15deg;--d:10.4s;--dl:-3.1s"></i><i style="--x:75%;--y:89%;--c:#a67cff;--r:114deg;--d:7.7s;--dl:-3.9s"></i><i style="--x:87%;--y:46%;--c:#ff5c99;--r:5deg;--d:11.6s;--dl:-3.6s"></i><i style="--x:80%;--y:16%;--c:#ffd23f;--r:126deg;--d:6.4s;--dl:-7.7s"></i></div>
    <a class="snd-skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Mallo Digital — home">
        <img
          src="/assets/brand-mark.svg"
          alt="Mallo Digital"
          width="250" height="70"
        />
      </a>
      <nav aria-label="Primary">
        <a href="/">Home</a>
        <a href="/services/">Services</a>
        <a href="/blog/">Blog</a>
        <a href="/book-a-call/">Book a Call</a>
        <a href="/contact/">Contact</a>
        <a href="https://app.shortnsweetdigital.com" rel="noopener">Login</a>
        <a href="https://www.skool.com/llmacademy/about?ref=7ec545cf11f44d1e9ebe40b09419916e" rel="noopener">LEARN</a>
        <a href="https://www.gohighlevel.com/?fp_ref=shortnsweet53&utm_source=site_nav&utm_medium=organic&utm_campaign=global_nav" rel="noopener" class="cta">Start free trial</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <a class="snd-mobile-cta" href="https://www.gohighlevel.com/?fp_ref=shortnsweet53&utm_source=site&utm_medium=organic&utm_campaign=mobile_sticky" rel="noopener">
      Start free trial →
    </a>
    <footer class="site-footer">
      <div class="preferred-source">
        <p>Like what you're reading? Get more of us in your Google results:</p>
        <div google-add-preferred-source-btn data-theme="dark"></div>
        <noscript>
          <a href="https://www.google.com/preferences/source?q=shortnsweetdigital.com" rel="noopener">
            Add Mallo Digital as a preferred source on Google
          </a>
        </noscript>
      </div>
      <p>&copy; {new Date().getFullYear()} Mallo Digital. All rights reserved.</p>
    </footer>

    <style is:global>
      :root {
        --fg: #fff7fb;
        --bg: #140a24;
        --muted: #d9cdf2;
        --accent: #ff5c99;
        --accent-2: #e8457f;
        --border: #3d2a66;
        --max-width: 72ch;
      }
      * { box-sizing: border-box; }
      .snd-skip-link {
        position: absolute; left: -9999px; top: 0;
        background: #e8457f; color: #fff; padding: 8px 14px;
        border-radius: 0 0 8px 0; z-index: 10000;
        text-decoration: none; font-weight: 700;
      }
      .snd-skip-link:focus { left: 0; }
      html, body {
        margin: 0;
        padding: 0;
        font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          Roboto, 'Helvetica Neue', Arial, sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
      }
      /* Match homepage: city image as fixed background, dark overlay for legibility */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
          radial-gradient(900px 600px at 10% -10%, rgba(255,92,153,0.28), transparent 60%),
          radial-gradient(800px 600px at 110% 20%, rgba(59,155,255,0.22), transparent 60%),
          radial-gradient(700px 500px at 50% 120%, rgba(94,242,192,0.16), transparent 60%),
          linear-gradient(180deg, #1a0f2e 0%, #221340 100%);
      }
      main { position: relative; z-index: 1; }
      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      h1, h2, h3, h4 {
        line-height: 1.2;
        color: var(--fg);
      }
      a { color: var(--accent); }
      a:hover { text-decoration: underline; }
      img { max-width: 100%; height: auto; }
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      .site-header .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .site-header .brand img {
        display: block;
        height: 56px;
        width: auto;
      }
      .site-header nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }
      .site-header nav a {
        margin-left: 0.5rem;
        padding: 0.4rem 0.75rem;
        color: var(--fg);
        text-decoration: none;
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 6px;
      }
      .site-header nav a:hover { background: rgba(255,255,255,0.06); }
      .site-header nav a.cta {
        background: var(--accent);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 999px;
      }
      .snd-mobile-cta {
        display: none;
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: 12px;
        z-index: 999;
        text-align: center;
        background: linear-gradient(120deg, #e8457f, #a67cff);
        color: #fff;
        font-weight: 700;
        padding: 14px 18px;
        border-radius: 999px;
        text-decoration: none;
        box-shadow: 0 12px 32px rgba(255,92,153, 0.4);
        font-family: 'Nunito', sans-serif;
      }
      @media (max-width: 720px) {
        .snd-mobile-cta { display: block; }
        main { padding-bottom: 5rem; }
      }
      .preferred-source {
        display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
        margin-bottom: 1.25rem;
      }
      .preferred-source p { margin: 0; color: var(--muted); font-size: 0.95rem; }
      .preferred-source a { color: #ffb3d1; }
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
