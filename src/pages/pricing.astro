---
import BaseLayout from '../layouts/BaseLayout.astro';

// P0-1 from the May 2026 SEO audit: /pricing returned a 404 while indexed at
// ~position 5 and taking 45 sessions/mo. This restores it as a real route.
const AFFILIATE = 'https://www.gohighlevel.com/?fp_ref=shortnsweet53&utm_source=site&utm_medium=organic&utm_campaign=pricing_page';

const tiers = [
  {
    name: 'Starter',
    price: '$97',
    cadence: '/mo',
    blurb: 'One account for a single business that wants every tool in one place.',
    features: [
      'Unlimited contacts & users',
      'CRM, pipelines & opportunities',
      'Email + 2-way SMS marketing',
      'Funnels, websites & forms',
      'Calendars & online booking',
      'Reputation & reviews',
    ],
    cta: 'Start free trial',
    featured: false,
  },
  {
    name: 'Unlimited',
    price: '$297',
    cadence: '/mo',
    blurb: 'For agencies running multiple clients — unlimited sub-accounts, one bill.',
    features: [
      'Everything in Starter',
      'Unlimited client sub-accounts',
      'API access & webhooks',
      'Branded desktop app',
      'Advanced automations & workflows',
      'AI employee add-ons',
    ],
    cta: 'Start free trial',
    featured: true,
  },
  {
    name: 'SaaS Pro',
    price: '$497',
    cadence: '/mo',
    blurb: 'Resell GoHighLevel as your own software with Stripe billing built in.',
    features: [
      'Everything in Unlimited',
      'Full white-label / SaaS mode',
      'Resell with your own pricing',
      'Stripe billing & rebilling',
      'Split testing & advanced API',
      'Priority support',
    ],
    cta: 'Start free trial',
    featured: false,
  },
];

const faqs = [
  {
    q: 'Is there a free trial?',
    a: 'Yes — every plan starts with a 14-day free trial. No credit card pressure, and we help you get set up before the trial ends.',
  },
  {
    q: 'What does Short n Sweet Digital add on top of GoHighLevel?',
    a: 'We do the build-out: sub-account setup, automations, pipelines, white-label DNS, and the integrations that actually drive revenue — so you launch in days, not months.',
  },
  {
    q: 'Can I switch plans later?',
    a: 'Yes. Most agencies start on Unlimited and move to SaaS Pro once they have a few white-label clients covering the cost.',
  },
  {
    q: 'Do you offer done-for-you setup?',
    a: 'We do. Book a free strategy call and we will map your current stack and scope the build before you commit to anything.',
  },
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'GoHighLevel via Short n Sweet Digital',
  description:
    'All-in-one CRM, marketing, and automation platform for small businesses and agencies, set up and supported by Short n Sweet Digital.',
  brand: { '@type': 'Brand', name: 'Short n Sweet Digital' },
  offers: tiers.map((t) => ({
    '@type': 'Offer',
    name: t.name,
    price: t.price.replace('$', ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://shortnsweetdigital.com/pricing/',
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="GoHighLevel Pricing — Plans from $97/mo | Short n Sweet Digital"
  description="GoHighLevel pricing through Short n Sweet Digital: Starter $97/mo, Unlimited $297/mo with unlimited client sub-accounts, and SaaS Pro $497/mo white-label. 14-day free trial."
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="pricing" data-snd-reveal>
    <p class="eyebrow">Pricing</p>
    <h1>Simple pricing. One platform. No surprise renewals.</h1>
    <p class="lede">
      Replace 8–12 marketing tools with one system — set up and supported by us.
      Every plan includes a 14-day free trial.
    </p>

    <div class="tiers">
      {tiers.map((t) => (
        <div class={`tier${t.featured ? ' featured' : ''}`}>
          {t.featured && <span class="badge">Most popular</span>}
          <h2>{t.name}</h2>
          <p class="price">{t.price}<span>{t.cadence}</span></p>
          <p class="blurb">{t.blurb}</p>
          <ul>
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class="tier-cta" href={AFFILIATE} rel="noopener">{t.cta} →</a>
        </div>
      ))}
    </div>

    <div class="assist">
      <h3>Not sure which plan fits?</h3>
      <p>Book a free strategy call and we'll scope it with you — no pitch, no pressure.</p>
      <a class="assist-cta" href="/book-a-call/">Book a free strategy call →</a>
    </div>

    <section class="faq">
      <h2>Pricing FAQ</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </section>

  <style>
    .pricing { padding: 1rem 0 4rem; }
    .eyebrow { color: #5271FF; font-weight: 800; letter-spacing: 0.12em; margin: 0 0 0.5rem; text-transform: uppercase; font-size: 0.85rem; }
    h1 { font-size: 2.3rem; line-height: 1.12; margin: 0 0 1rem; }
    .lede { color: var(--muted); font-size: 1.1rem; max-width: 620px; margin: 0 0 2.5rem; }

    .tiers {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 18px;
      align-items: stretch;
    }
    .tier {
      position: relative;
      display: flex; flex-direction: column;
      padding: 28px 24px;
      border-radius: 16px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(82, 113, 255, 0.22);
    }
    .tier.featured {
      border-color: #5271FF;
      box-shadow: 0 18px 50px -18px rgba(82, 113, 255, 0.6);
    }
    .badge {
      position: absolute; top: -11px; left: 24px;
      background: linear-gradient(90deg, #188bf6, #5271FF);
      color: #fff; font-size: 0.72rem; font-weight: 800;
      letter-spacing: 0.06em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 999px;
    }
    .tier h2 { margin: 0 0 6px; font-size: 1.25rem; color: #fff; }
    .price { margin: 0 0 12px; font-size: 2.2rem; font-weight: 800; color: #fff; }
    .price span { font-size: 1rem; font-weight: 600; color: var(--muted); }
    .blurb { color: var(--muted); font-size: 0.92rem; margin: 0 0 16px; line-height: 1.5; }
    .tier ul { list-style: none; padding: 0; margin: 0 0 22px; flex: 1; }
    .tier li {
      position: relative; padding: 6px 0 6px 24px; color: #e2e8f0; font-size: 0.92rem;
    }
    .tier li::before { content: "✓"; position: absolute; left: 0; color: #22c55e; font-weight: 800; }
    .tier-cta {
      display: block; text-align: center;
      padding: 12px 18px; border-radius: 12px;
      background: linear-gradient(90deg, #188bf6, #5271FF);
      color: #fff; font-weight: 700; text-decoration: none;
    }
    .tier-cta:hover { filter: brightness(1.08); }

    .assist {
      margin-top: 2.5rem; padding: 24px;
      border-radius: 16px; text-align: center;
      background: rgba(5, 100, 209, 0.08);
      border: 1px solid rgba(5, 100, 209, 0.25);
    }
    .assist h3 { margin: 0 0 6px; color: #fff; }
    .assist p { margin: 0 0 14px; color: var(--muted); }
    .assist-cta {
      display: inline-block; padding: 11px 20px; border-radius: 12px;
      border: 1px solid rgba(82, 113, 255, 0.5); color: #f8fafc;
      text-decoration: none; font-weight: 700;
    }
    .assist-cta:hover { background: rgba(82, 113, 255, 0.15); }

    .faq { margin-top: 3rem; }
    .faq h2 { font-size: 1.5rem; margin: 0 0 1rem; }
    .faq details {
      border-bottom: 1px solid rgba(148, 163, 184, 0.18);
      padding: 14px 0;
    }
    .faq summary { cursor: pointer; font-weight: 600; color: #f8fafc; font-size: 1.02rem; }
    .faq p { margin: 10px 0 0; color: var(--muted); line-height: 1.55; }
  </style>
</BaseLayout>
