---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';

const SITE = 'https://shortnsweetdigital.com';
const FORM_URL = 'https://seo.shortnsweetdigital.com/widget/form/TZ4OcFkYoLidVNPKL33A';
const FORM_HELPER = 'https://seo.shortnsweetdigital.com/js/form_embed.js';
const socials = [
  { label: 'Facebook', href: 'https://www.facebook.com/shortnsweetmarketing' },
  { label: 'Instagram', href: 'https://www.instagram.com/shortnsweetdigital' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/shortnsweet-marketing/' },
];

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Mallo Digital',
  url: `${SITE}/contact/`,
  about: {
    '@type': 'Organization',
    name: 'Mallo Digital',
    url: `${SITE}/`,
    founder: { '@type': 'Person', name: 'Josh Hart' },
    sameAs: socials.map((s) => s.href),
  },
};
---

<BaseLayout
  title="Contact — Mallo Digital"
  description="Contact Mallo Digital. Send us a message, book a free strategy call, or reach us on Facebook, Instagram or LinkedIn."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactLd)} />

  <section class="intro" data-snd-reveal>
    <p class="eyebrow">Contact</p>
    <Mascot name="blip" size={140} eager />
    <h1>Say hello. We read every message.</h1>
    <p class="lede">
      Questions about the platform, pricing or moving your tools over? Send us a note below and
      we will get back to you. If you would rather talk it through, book a free call.
    </p>
  </section>

  <section class="form snd-darkened" data-snd-reveal>
    <h2>Send us a message</h2>
    <iframe
      src={FORM_URL}
      style="width:100%;height:887px;border:none;border-radius:12px"
      id="inline-TZ4OcFkYoLidVNPKL33A"
      data-layout="{'id':'INLINE'}"
      data-trigger-type="alwaysShow"
      data-trigger-value=""
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name="Main Website Contact Form"
      data-height="887"
      data-layout-iframe-id="inline-TZ4OcFkYoLidVNPKL33A"
      data-form-id="TZ4OcFkYoLidVNPKL33A"
      title="Main Website Contact Form"
      loading="lazy"></iframe>
    <script is:inline src={FORM_HELPER} defer></script>
  </section>

  <section class="other" data-snd-reveal>
    <h2>Other ways to reach us</h2>
    <div class="grid">
      <div class="card snd-darkened">
        <h3>Book a call</h3>
        <p>A free 30-minute strategy call to map your current tools and what we can replace.</p>
        <a class="btn-primary" href="/book-a-call/">Book a call</a>
      </div>
      <div class="card snd-darkened">
        <h3>Find us on social</h3>
        <ul>
          {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label} ↗</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <style>
    section { padding: 1.5rem 0; }
    h1, h2, h3 { font-family: var(--display); color: #fff7fb; }
    h1 { font-size: 2.2rem; line-height: 1.15; margin: 0.5rem 0 1rem; }
    .lede { color: #d9cdf2; font-size: 1.1rem; }
    .form { padding: 1.5rem; border-radius: 20px; }
    .form h2 { margin-top: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
    .card { padding: 1.5rem; border-radius: 20px; }
    .card h3 { margin: 0 0 0.5rem; }
    .card p { color: #d9cdf2; }
    .card ul { list-style: none; padding: 0; margin: 0; }
    .card li { margin-bottom: 0.5rem; }
    .card li a { color: #5ef2c0; font-weight: 700; text-decoration: none; }
  </style>
</BaseLayout>
