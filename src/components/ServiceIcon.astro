---
// Animated candy-style service icons (inline SVG + CSS). Replaces the old GHL gifs.
interface Props { name: string; size?: number }
const { name, size = 96 } = Astro.props;
const O = '#2a1850';
---
<span class={`svc-icon svc-${name}`} style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 96 96" width={size} height={size}>
    <circle cx="48" cy="48" r="44" class="blob" />
    {name === 'reviews' && (<g class="bounce">
      <path d="M48 18 l8.5 17.5 19.5 2.8 -14 13.6 3.3 19.3 -17.3 -9.1 -17.3 9.1 3.3 -19.3 -14 -13.6 19.5 -2.8z" fill="#ffd23f" stroke={O} stroke-width="3.5" stroke-linejoin="round"/>
      <circle cx="42" cy="47" r="2.6" fill={O}/><circle cx="54" cy="47" r="2.6" fill={O}/><path d="M44 54 q4 4 8 0" stroke={O} stroke-width="2.6" fill="none" stroke-linecap="round"/>
    </g>)}
    {name === 'messaging' && (<g>
      <rect x="16" y="22" width="56" height="40" rx="16" fill="#ff5c99" stroke={O} stroke-width="3.5"/>
      <path d="M30 60 l-6 14 16 -12" fill="#ff5c99" stroke={O} stroke-width="3.5" stroke-linejoin="round"/>
      <circle class="dot d1" cx="32" cy="42" r="4.5" fill="#fff"/><circle class="dot d2" cx="44" cy="42" r="4.5" fill="#fff"/><circle class="dot d3" cx="56" cy="42" r="4.5" fill="#fff"/>
    </g>)}
    {name === 'webchat' && (<g>
      <rect x="14" y="20" width="62" height="48" rx="10" fill="#fff7fb" stroke={O} stroke-width="3.5"/>
      <path d="M14 32 h62" stroke={O} stroke-width="3.5"/><circle cx="22" cy="26" r="2" fill="#ff5c99"/><circle cx="29" cy="26" r="2" fill="#ffd23f"/><circle cx="36" cy="26" r="2" fill="#5ef2c0"/>
      <g class="pop"><rect x="44" y="46" width="36" height="24" rx="12" fill="#3b9bff" stroke={O} stroke-width="3.5"/><path d="M56 58 h12" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
    </g>)}
    {name === 'crm' && (<g>
      <rect x="18" y="62" width="12" height="14" rx="3" class="bar b1" fill="#5ef2c0" stroke={O} stroke-width="3"/>
      <rect x="36" y="48" width="12" height="28" rx="3" class="bar b2" fill="#3b9bff" stroke={O} stroke-width="3"/>
      <rect x="54" y="34" width="12" height="42" rx="3" class="bar b3" fill="#ff5c99" stroke={O} stroke-width="3"/>
      <circle cx="72" cy="24" r="9" fill="#ffd23f" stroke={O} stroke-width="3" class="bounce"/>
    </g>)}
    {name === 'payments' && (<g>
      <rect x="14" y="30" width="56" height="38" rx="8" fill="#a67cff" stroke={O} stroke-width="3.5"/>
      <path d="M14 42 h56" stroke={O} stroke-width="5"/><rect x="22" y="54" width="18" height="6" rx="3" fill="#fff7fb"/>
      <g class="flip"><circle cx="70" cy="30" r="13" fill="#ffd23f" stroke={O} stroke-width="3.5"/><text x="70" y="36" text-anchor="middle" font-size="16" font-weight="900" fill={O} font-family="Nunito,sans-serif">$</text></g>
    </g>)}
    {name === 'missed-call' && (<g>
      <g class="ring"><path d="M28 20 c-6 0 -10 5 -9 11 c3 22 18 37 40 41 c6 1 11 -3 11 -9 v-6 c0 -3 -2 -5 -5 -6 l-9 -3 c-3 -1 -6 0 -7 3 l-2 4 c-9 -4 -15 -10 -19 -19 l4 -2 c3 -1 4 -4 3 -7 l-3 -9 c-1 -3 -3 -5 -6 -5z" fill="#5ef2c0" stroke={O} stroke-width="3.5" stroke-linejoin="round"/></g>
      <g class="pop"><rect x="50" y="14" width="32" height="22" rx="11" fill="#ff5c99" stroke={O} stroke-width="3"/><path d="M60 25 h12" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
    </g>)}
    {name === 'ai-assistant' && (<g class="bounce">
      <path d="M48 16 v8" stroke={O} stroke-width="3.5" stroke-linecap="round"/><circle cx="48" cy="14" r="5" fill="#ff5c99" stroke={O} stroke-width="3" class="glow"/>
      <rect x="20" y="26" width="56" height="44" rx="20" fill="#fff7fb" stroke={O} stroke-width="3.5"/>
      <rect x="28" y="36" width="40" height="22" rx="11" fill={O}/>
      <rect x="37" y="41" width="6" height="12" rx="3" fill="#5ef2c0" class="blink"/><rect x="53" y="41" width="6" height="12" rx="3" fill="#5ef2c0" class="blink"/>
      <path d="M78 30 l3 -7 3 7 7 3 -7 3 -3 7 -3 -7 -7 -3z" fill="#ffd23f" class="spark"/>
    </g>)}
    {name === 'mobile-app' && (<g>
      <rect x="30" y="14" width="36" height="68" rx="10" fill="#3b9bff" stroke={O} stroke-width="3.5"/>
      <rect x="35" y="22" width="26" height="46" rx="4" fill="#fff7fb"/>
      <rect x="39" y="28" width="18" height="6" rx="3" fill="#ff5c99"/><rect x="39" y="38" width="14" height="6" rx="3" fill="#a67cff"/><rect x="39" y="48" width="18" height="6" rx="3" fill="#5ef2c0"/>
      <g class="pop"><circle cx="66" cy="18" r="9" fill="#ff5c99" stroke={O} stroke-width="3"/><text x="66" y="22.5" text-anchor="middle" font-size="12" font-weight="900" fill="#fff" font-family="Nunito,sans-serif">3</text></g>
    </g>)}
  </svg>
</span>

<style>
  .svc-icon { display: inline-block; width: var(--s); height: var(--s); }
  .svc-icon svg { display: block; overflow: visible; }
  .blob { fill: rgba(255, 255, 255, 0.07); }
  .svc-icon :global(*) { transform-box: fill-box; transform-origin: center; }
  .bounce { animation: svc-bounce 2.2s cubic-bezier(.34,1.56,.64,1) infinite; }
  .dot { animation: svc-dot 1.2s ease-in-out infinite; }
  .d2 { animation-delay: .15s; } .d3 { animation-delay: .3s; }
  .pop { animation: svc-pop 2.4s cubic-bezier(.34,1.56,.64,1) infinite; }
  .bar { transform-origin: bottom; animation: svc-grow 2.4s cubic-bezier(.34,1.56,.64,1) infinite; }
  .b2 { animation-delay: .15s; } .b3 { animation-delay: .3s; }
  .flip { animation: svc-flip 2.4s ease-in-out infinite; }
  .ring { animation: svc-ring 2.4s ease-in-out infinite; }
  .blink { animation: svc-blink 3s infinite; }
  .spark { animation: svc-spark 1.8s ease-in-out infinite; }
  .glow { animation: svc-glow 1.6s ease-in-out infinite; }
  @keyframes svc-bounce { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-6px) rotate(-4deg); } 60% { transform: translateY(0) scale(1.04, .96); } }
  @keyframes svc-dot { 0%, 100% { transform: translateY(0); opacity: .5; } 50% { transform: translateY(-4px); opacity: 1; } }
  @keyframes svc-pop { 0%, 20% { transform: scale(0); } 35% { transform: scale(1.15); } 45%, 85% { transform: scale(1); } 100% { transform: scale(0); } }
  @keyframes svc-grow { 0% { transform: scaleY(.3); } 40%, 80% { transform: scaleY(1); } 100% { transform: scaleY(.3); } }
  @keyframes svc-flip { 0%, 40% { transform: rotateY(0); } 60%, 100% { transform: rotateY(360deg); } }
  @keyframes svc-ring { 0%, 50%, 100% { transform: rotate(0); } 5%, 15%, 25% { transform: rotate(-12deg); } 10%, 20%, 30% { transform: rotate(12deg); } }
  @keyframes svc-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes svc-spark { 0%, 100% { transform: scale(.7) rotate(0); } 50% { transform: scale(1.15) rotate(45deg); } }
  @keyframes svc-glow { 0%, 100% { opacity: .7; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .svc-icon :global(*) { animation: none !important; } }
</style>
