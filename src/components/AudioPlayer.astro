---
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---

<section class="audio">
  <h4>🎧 Listen to this post</h4>
  <audio controls preload="metadata" aria-label={`Audio version of ${title}`}>
    <source src={src} type="audio/mpeg" />
    Your browser does not support the audio element.
  </audio>
</section>

<style>
  .audio {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border: 3px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background: #2a1850;
    box-shadow: 6px 6px 0 #ffd23f;
  }
  .audio h4 {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    color: #ffd23f;
    font-family: var(--display, 'Nunito', sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .audio audio {
    width: 100%;
    border-radius: 999px;
    color-scheme: dark;
  }
</style>
